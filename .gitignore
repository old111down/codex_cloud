# Local runtime state and credentials are never archive payloads.
.env
.env.*
!.env.example
*.pem
*.key
id_rsa*
id_ed25519*
.ssh/
.conda/
conda-envs/
.venv/
venv/
__pycache__/
*.pyc
.DS_Store
.local/
scratch/
upstream/
runtime-artifacts/
**/runtime-artifacts/
# Raw traffic/model/environment binaries require separate explicit review.
*.pcap
*.pcapng
*.pth
*.pt
*.ckpt
*.pkl
*.pickle
*.onnx
*.safetensors
*.bundle

# Unreviewed document/data/archive binaries need an explicit reviewed exception.
*.pdf
*.npy
*.npz
*.parquet
*.h5
*.hdf5
*.joblib
*.bin
*.so
*.sqlite
*.sqlite3
*.db
*.zip
*.tar
*.tar.gz
*.tgz
*.7z
