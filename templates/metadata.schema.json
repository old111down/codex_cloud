{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/old111down/codex_cloud/blob/main/templates/metadata.schema.json",
  "title": "Codex Cloud archived task metadata",
  "description": "Generic task record. Status/evidence fields do not themselves prove execution or scientific validity. Additional task-specific fields are permitted.",
  "type": "object",
  "required": [
    "task_id",
    "task_name",
    "task_slug",
    "run_id",
    "archive_repository",
    "start_time_utc",
    "end_time_utc",
    "objective",
    "source_repositories",
    "runtime_environment",
    "commands_executed",
    "completed_work",
    "failed_experiments",
    "important_findings",
    "unverified_claims",
    "artifacts",
    "final_status"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "task_name": {
      "type": "string",
      "minLength": 1
    },
    "task_slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "archive_repository": {
      "type": "string",
      "const": "https://github.com/old111down/codex_cloud"
    },
    "start_time_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        },
        {
          "const": "Unknown"
        }
      ],
      "description": "Actual task/research UTC start, not a reset archive-export time. A genuinely unavailable historical start must be Unknown, not invented."
    },
    "end_time_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        },
        {
          "type": "null"
        },
        {
          "const": "Unknown"
        }
      ],
      "description": "Actual UTC end when known; null while in progress, Unknown if genuinely unavailable."
    },
    "archive_started_time_utc": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
    },
    "archive_completed_time_utc": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        },
        {
          "type": "null"
        },
        {
          "const": "Unknown"
        }
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "pattern": "^codex/[a-z0-9]+(?:-[a-z0-9]+)*/[0-9]{8}T[0-9]{6}Z-[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "related_runs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "run_id",
          "relation"
        ],
        "properties": {
          "run_id": {
            "type": "string"
          },
          "relation": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": true
      }
    },
    "source_repositories": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "url",
          "commit_shas"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "minLength": 1
          },
          "branch": {
            "type": "string"
          },
          "commit_shas": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64}|Unknown)$"
            }
          },
          "license": {
            "type": "string"
          },
          "version_status": {
            "type": "string",
            "enum": [
              "Verified",
              "Partially Verified",
              "Failed",
              "Unknown"
            ]
          },
          "evidence": {
            "$ref": "#/$defs/evidenceRefs"
          }
        },
        "additionalProperties": true
      }
    },
    "runtime_environment": {
      "type": "object",
      "description": "Observed environment and limitations, with optional links to declarations/version probes. Missing facts remain Unknown.",
      "additionalProperties": true
    },
    "commands_executed": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "command",
          "status"
        ],
        "properties": {
          "command": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "cwd": {
            "type": "string"
          },
          "start_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
              },
              {
                "type": "null"
              },
              {
                "const": "Unknown"
              }
            ]
          },
          "end_time_utc": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
              },
              {
                "type": "null"
              },
              {
                "const": "Unknown"
              }
            ]
          },
          "exit_code": {
            "type": [
              "integer",
              "null"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Partially Verified",
              "Failed",
              "Unknown"
            ]
          },
          "scope": {
            "type": "string"
          },
          "inherited": {
            "type": "boolean"
          },
          "evidence": {
            "$ref": "#/$defs/evidenceRefs"
          }
        },
        "additionalProperties": true
      }
    },
    "completed_work": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "failed_experiments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "important_findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "unverified_claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "status"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^(?:[0-9a-fA-F]{64}|Unknown)$"
          },
          "status": {
            "type": "string",
            "enum": [
              "Verified",
              "Partially Verified",
              "Failed",
              "Unknown"
            ]
          },
          "publication_review": {
            "type": "string",
            "enum": [
              "approved",
              "sanitized",
              "withheld_for_manual_review",
              "Unknown"
            ]
          },
          "source_url": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidenceRefs"
          }
        },
        "additionalProperties": true
      }
    },
    "publication_review": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Verified",
            "Partially Verified",
            "Failed",
            "Unknown"
          ]
        },
        "manifest": {
          "type": "string"
        },
        "withheld_manifest": {
          "type": "string"
        },
        "limitations": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "final_status": {
      "type": "string",
      "enum": [
        "Verified",
        "Partially Verified",
        "Failed",
        "Unknown"
      ]
    },
    "final_status_scope": {
      "type": "string",
      "description": "Distinguish completed audit/archive work from unverified subject-matter or paper-result claims."
    },
    "remote_verification": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "Verified",
            "Partially Verified",
            "Failed",
            "Unknown"
          ]
        },
        "branch": {
          "type": "string"
        },
        "commit_sha": {
          "type": "string",
          "pattern": "^(?:[0-9a-fA-F]{40}|[0-9a-fA-F]{64}|Unknown)$"
        },
        "checked_at_utc": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?(?:Z|\\+00:00)$"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": true
    },
    "pull_request_url": {
      "type": [
        "string",
        "null"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidenceRefs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "description",
        "status"
      ],
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "Verified",
            "Partially Verified",
            "Failed",
            "Unknown"
          ]
        },
        "evidence_type": {
          "type": "string",
          "enum": [
            "source_fact",
            "runtime_observation",
            "hypothesis",
            "unverified_question",
            "archive_operation",
            "Unknown"
          ]
        },
        "scope": {
          "type": "string"
        },
        "evidence": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true,
  "$comment": "Use a JSON Schema validator with date-time format support and explicitly parse timestamps as UTC. The UTC syntax pattern alone does not establish a valid calendar date; retain Unknown when historical times are unavailable."
}
